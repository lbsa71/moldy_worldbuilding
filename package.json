{
  "name": "moldy_worldbuilding",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run clean && astro build && node scripts/prepare-release.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "build:wasm": "cd src/game/wasm && npx asc assembly/gameLogic.ts --target release --optimize",
    "clean": "node scripts/clean.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run test && npm run check && npm run build",
    "score:render": "node scripts/generate-score.mjs"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@babylonjs/core": "^7.34.4",
    "@babylonjs/gui": "^7.40.3",
    "@babylonjs/havok": "^1.3.10",
    "@babylonjs/loaders": "^7.35.0",
    "@types/babylonjs": "^2.3.31",
    "assemblyscript": "^0.27.31",
    "astro": "^7.3.5",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.7"
  }
}
