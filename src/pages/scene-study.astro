---
// A separate art review surface keeps the playable chapter intact during look development.
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="description" content="A fixed-view scene study for Fading, with the opening artwork available for comparison." />
    <title>Fading — Scene study</title>
  </head>
  <body>
    <main>
      <header>
        <div class="heading"><h1>Fading</h1><p>A place that changes around you</p></div>
        <a href="/">Play the current chapter</a>
      </header>

      <figure aria-labelledby="scene-caption">
        <div class="stage" id="study-stage" data-comparison="live">
          <canvas id="study-canvas" aria-label="A fixed scene of a lamp, chair and cup beside water. Use the controls below to change the arrangement."></canvas>
          <img id="study-reference" src="/assets/fading-title.webp" alt="Opening reference: a warm brass lamp and worn chair on a wet shore, with cool water and distant cliffs." width="1536" height="1024" aria-hidden="true" />
          <div id="study-loading" role="status">Preparing the scene…</div>
          <span id="comparison-label" hidden>Opening reference</span>
        </div>
        <figcaption id="scene-caption">
          <span id="asset-status" role="status" aria-live="polite">Loading the fixed-view study.</span>
          <span id="backend-status"></span>
        </figcaption>
      </figure>

      <section class="review-controls" aria-label="Scene study controls">
        <fieldset id="arrangement-controls" disabled>
          <legend>Change the arrangement</legend>
          <label><input id="chair-turned" type="checkbox" /> Turn the chair</label>
          <label><input id="cup-removed" type="checkbox" /> Remove the cup</label>
          <button id="reset-scene" type="button">Restore the opening</button>
        </fieldset>
        <fieldset class="comparison-controls">
          <legend>Compare the composition</legend>
          <div class="comparison-buttons" role="group" aria-label="Comparison view">
            <button type="button" data-view="live" aria-pressed="true">Live scene</button>
            <button type="button" data-view="reference" aria-pressed="false">Opening image</button>
            <button type="button" data-view="overlay" aria-pressed="false">Overlay</button>
          </div>
          <label><input id="reduced-motion" type="checkbox" /> Reduce motion</label>
        </fieldset>
      </section>

      <footer>
        <p>This is a visual study. Look for a steady composition, grounded objects, and shadows and reflections that follow each change.</p>
        <details id="render-details"><summary>Rendering notes</summary><pre id="render-diagnostics">Waiting for the renderer.</pre></details>
      </footer>
    </main>
    <script>
      import { createSceneStudy, type SceneStudyHandle } from '../components/scene-study/createSceneStudy';
      import { getSceneStudyState } from '../components/scene-study/SceneStudyState';

      const canvas = document.querySelector<HTMLCanvasElement>('#study-canvas')!;
      const stage = document.querySelector<HTMLElement>('#study-stage')!;
      const loading = document.querySelector<HTMLElement>('#study-loading')!;
      const status = document.querySelector<HTMLElement>('#asset-status')!;
      const backend = document.querySelector<HTMLElement>('#backend-status')!;
      const diagnostics = document.querySelector<HTMLElement>('#render-diagnostics')!;
      const arrangement = document.querySelector<HTMLFieldSetElement>('#arrangement-controls')!;
      const chair = document.querySelector<HTMLInputElement>('#chair-turned')!;
      const cup = document.querySelector<HTMLInputElement>('#cup-removed')!;
      const reduced = document.querySelector<HTMLInputElement>('#reduced-motion')!;
      const label = document.querySelector<HTMLElement>('#comparison-label')!;
      const comparisonButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-view]')];
      const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
      reduced.checked = motionPreference.matches;
      let controller: SceneStudyHandle | undefined;
      let disposed = false;
      const startup = new AbortController();

      function showDiagnostics() {
        if (!controller) return;
        const info = controller.getDiagnostics();
        diagnostics.textContent = JSON.stringify(info, null, 2);
        backend.textContent = info.backend;
        status.textContent = info.assetMode === 'production'
          ? 'Blender scene loaded · fidelity review in progress'
          : 'Provisional asset study · detailed reconstruction pending';
      }
      function applyArrangement() {
        controller?.setChairTurned(chair.checked);
        controller?.setCupVisible(!cup.checked);
        showDiagnostics();
      }
      chair.addEventListener('change', applyArrangement);
      cup.addEventListener('change', applyArrangement);
      reduced.addEventListener('change', () => {
        controller?.setReducedMotion(reduced.checked);
        showDiagnostics();
      });
      document.querySelector('#reset-scene')!.addEventListener('click', () => {
        const opening = getSceneStudyState('reset', reduced.checked);
        chair.checked = opening.chairTurned;
        cup.checked = !opening.cupVisible;
        controller?.reset();
        controller?.setReducedMotion(opening.reducedMotion);
        showDiagnostics();
      });
      comparisonButtons.forEach(button => button.addEventListener('click', () => {
        const view = button.dataset.view || 'live';
        stage.dataset.comparison = view;
        comparisonButtons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
        label.hidden = view === 'live';
        label.textContent = view === 'overlay' ? '50% opening reference overlay' : 'Opening reference · still artwork';
        canvas.setAttribute('aria-hidden', String(view === 'reference'));
        document.querySelector('#study-reference')!.setAttribute('aria-hidden', String(view === 'live'));
      }));
      document.querySelector('#render-details')!.addEventListener('toggle', showDiagnostics);
      const updateMotion = (event: MediaQueryListEvent) => {
        reduced.checked = event.matches;
        controller?.setReducedMotion(event.matches);
      };
      motionPreference.addEventListener('change', updateMotion);
      window.addEventListener('pagehide', () => {
        disposed = true;
        startup.abort();
        controller?.dispose();
        motionPreference.removeEventListener('change', updateMotion);
      }, { once: true });
      window.addEventListener('pageshow', event => { if (event.persisted) window.location.reload(); });

      try {
        const result = await createSceneStudy(canvas, {
          forceWebGL: new URLSearchParams(window.location.search).get('renderer') === 'webgl',
          signal: startup.signal,
          environment: { url: '/scene-study/overcast.hdr', intensity: 0.55 },
          onStatus: message => { if (!disposed) loading.textContent = message; },
        });
        if (disposed) result.dispose();
        else {
          controller = result;
          controller.setReducedMotion(reduced.checked);
          loading.hidden = true;
          arrangement.disabled = false;
          showDiagnostics();
        }
      } catch (error) {
        if (!disposed) {
          loading.textContent = 'The scene could not open. The opening image is available for comparison.';
          status.textContent = 'Renderer unavailable. Reload to try again.';
          diagnostics.textContent = error instanceof Error ? error.message : String(error);
        }
        console.error('Fading scene study could not start:', error);
      }
    </script>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { color-scheme: dark; background: #101b22; color: #dddcd2; font-family: 'Avenir Next', 'Segoe UI', sans-serif; }
  body { margin: 0; min-width: 320px; }
  main { max-width: 1560px; margin: 0 auto; padding: 24px clamp(18px, 4vw, 64px) 32px; }
  header { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; margin-bottom: 22px; }
  .heading { display: flex; align-items: baseline; gap: 20px; }
  h1 { margin: 0; color: #e5dfce; font: 400 2.3rem/1 'Palatino Linotype', Palatino, serif; letter-spacing: -.045em; }
  .heading p, footer p { color: #a9b7bb; font-size: .84rem; line-height: 1.6; margin: 0; }
  a { color: #d6b57e; text-decoration-thickness: 1px; text-underline-offset: 5px; font-size: .8rem; }
  figure { margin: 0; }
  .stage { position: relative; width: min(100%, calc((100dvh - 245px) * 1.5)); min-width: min(100%, 480px); aspect-ratio: 3 / 2; margin: 0 auto; background: #131e28; overflow: hidden; }
  canvas, #study-reference { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  canvas { touch-action: pan-y; }
  #study-reference { opacity: 0; object-fit: contain; pointer-events: none; }
  [data-comparison='reference'] #study-reference { opacity: 1; }
  [data-comparison='overlay'] #study-reference { opacity: .5; }
  #study-loading { position: absolute; inset: 0; display: grid; place-items: center; padding: 32px; text-align: center; background: #101b22d9; color: #c9d2d1; font-size: .9rem; }
  [data-comparison='reference'] #study-loading { display: none; }
  #comparison-label { position: absolute; left: 14px; bottom: 14px; padding: 7px 10px; background: #101b22df; color: #e1d2b6; font-size: .72rem; }
  figcaption { display: flex; justify-content: space-between; gap: 16px; margin-top: 12px; color: #9bafb7; font-size: .72rem; line-height: 1.5; }
  .review-controls { display: flex; justify-content: space-between; gap: 24px; margin-top: 20px; }
  fieldset { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; border: 0; padding: 0; margin: 0; }
  legend { color: #c6c9c0; padding: 0; margin-bottom: 10px; font: 400 1rem/1.3 'Palatino Linotype', Palatino, serif; }
  label { display: inline-flex; align-items: center; gap: 7px; min-height: 38px; font-size: .8rem; cursor: pointer; }
  input { accent-color: #cda86f; width: 16px; height: 16px; }
  button { min-height: 38px; padding: 8px 12px; border: 1px solid #52616a; border-radius: 2px; background: transparent; color: #d3dedf; font: 400 .78rem/1.35 'Avenir Next', 'Segoe UI', sans-serif; cursor: pointer; }
  button:hover { background: #253440; }
  button[aria-pressed='true'] { border-color: #c8a66e; color: #e6d0ac; background: #c9a36512; }
  :disabled { cursor: wait; opacity: .6; }
  .comparison-buttons { display: flex; gap: 6px; }
  :focus-visible { outline: 2px solid #e6c593; outline-offset: 4px; }
  footer { margin-top: 22px; display: flex; align-items: baseline; justify-content: space-between; gap: 30px; }
  footer p { max-width: 68ch; font-size: .75rem; }
  details { flex: 0 0 auto; font-size: .75rem; color: #9cafb5; max-width: 100%; }
  summary { min-height: 32px; cursor: pointer; }
  pre { max-width: 600px; overflow: auto; padding: 18px; background: #08131c; font-size: .72rem; }
  @media (max-width: 800px) { .heading { display: block; } .heading p { margin-top: 8px; } .review-controls, footer { flex-direction: column; } .stage { width: 100%; } header { align-items: center; } }
  @media (max-width: 440px) { main { padding-inline: 16px; } header { gap: 12px; } h1 { font-size: 2rem; } .heading p { max-width: 22ch; font-size: .75rem; } header a { max-width: 12ch; line-height: 1.5; } }
</style>
