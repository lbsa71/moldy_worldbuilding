<!-- src/pages/index.astro -->
---
import Game from '../components/Game.astro';
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta
            name="description"
            content="Fading is a contemplative 3D narrative game about memory, silence, and a lamp that remains."
        />
        <title>Fading</title>
    </head>
    <body>
        <Game />
    </body>
</html>

<style is:global>
    html,
    body {
        margin: 0;
        min-width: 320px;
        min-height: 100%;
        background: #050705;
        color: #f4f2e8;
        font-family: system-ui, sans-serif;
    }

    body {
        overflow: hidden;
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }
</style>
