---
import '../game/experience/experience.css';
---
<div id="game-container" class="game-container">
  <canvas id="gameCanvas" tabindex="-1" aria-label="A lamp, empty chair and chipped cup on a dissolving stone shore. The view and arrangement respond to your choices."></canvas>
  <div id="scene-transition" aria-hidden="true"></div>
  <div id="statsOverlay" hidden>
    <div>Renderer: <span id="rendererType">Loading…</span></div>
    <div>FPS: <span id="fpsCounter">0</span></div>
    <div>AA: <span id="aaType">Loading…</span></div>
    <div>Weather: <span id="weatherType">none</span></div>
  </div>
  <div id="experience-ui" hidden></div>
  <section id="launchScreen" class="launch-screen" aria-labelledby="launch-title" aria-describedby="launch-copy launch-status">
    <img class="launch-art" src="/assets/fading-title.webp" alt="" width="1536" height="1024" fetchpriority="high" />
    <div class="launch-content">
      <p class="launch-kicker">A place beside the light</p>
      <h1 id="launch-title">Fading</h1>
      <p id="launch-copy" class="launch-copy">Someone left the lamp on.<br />Someone is still trying to remember why.</p>
      <button id="start-button" class="start-button" type="button">Enter the quiet</button>
      <p id="launch-status" class="launch-status" aria-live="polite"></p>
      <p class="launch-guidance">A place changes as you listen. Take your time. Sound is optional; headphones invite you closer.</p>
    </div>
    <p class="launch-footer">Memory, care, and the things we leave unfinished.</p>
  </section>
  <noscript><p class="launch-screen">Fading needs JavaScript to render its world and choices. Enable JavaScript, then reload to begin.</p></noscript>
</div>

<script>
  import { createLaunchExperience } from '../game/experience/launchExperience';
  import inkFile from '../ink/demo.ink?raw';
  const canvas = document.getElementById('gameCanvas') as HTMLCanvasElement;
  const launchScreen = document.getElementById('launchScreen')!;
  const startButton = document.getElementById('start-button') as HTMLButtonElement;
  const rendererType = document.getElementById('rendererType')!;
  const fpsCounter = document.getElementById('fpsCounter')!;
  const statusText = document.getElementById('launch-status');
  if (new URLSearchParams(location.search).has('debug')) document.getElementById('statsOverlay')!.hidden = false;
  try {
    if (localStorage.getItem('fading:chapter-one:save:v4')) startButton.textContent = 'Return to the light';
  } catch { /* Storage is optional. */ }
  const launch = createLaunchExperience({
    canvas, launchScreen, startButton, rendererType, fpsCounter, statusText,
    // A renderer recovery may replace a context-bound canvas before a retry.
    getCanvas: () => document.getElementById('gameCanvas') as HTMLCanvasElement,
    // Legacy physics WASM is not part of this narrative runtime.
    loadWasm: async () => true,
    gameFactory: async (gameCanvas) => {
      const [{ GameScene }, { Compiler }] = await Promise.all([
        import('./GameScene'), import('../inkjs/compiler/Compiler'),
      ]);
      const game = new GameScene(gameCanvas);
      game.setStory(new Compiler(inkFile).Compile());
      return game;
    },
    onError: (error) => console.error('Fading could not start:', error),
  });
  window.addEventListener('pagehide', () => launch.destroy(), { once: true });
  window.addEventListener('pageshow', (event) => { if (event.persisted) location.reload(); });
</script>
