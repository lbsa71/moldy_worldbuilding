{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client", "astro/client", "node"],
    "baseUrl": ".",
    "paths": {
      "src/*": ["src/*"]
    },
    "outDir": "dist"
  },
  "exclude": [
    "node_modules",
    "dist",
    "terraform/**/*",
    "src/components/game-demo-backup/**/*",
    "src/game/wasm/assembly/**/*"
  ]
}
